{{/* .chezmoi.os is chezmoi's built-in darwin/linux branch var; used directly in templates. */}}
{{/* DOTFILES_PROFILE is set only by install.sh, so a plain `chezmoi init` is a Workstation. */}}
[data]
    email = "gui.g.azzi@gmail.com"
    userFullName = "Guilherme Grochau Azzi"
    devcontainer = {{ eq (env "DOTFILES_PROFILE") "devcontainer" }}
{{- /* Obsidian vault for the log-work skill; empty means the skill prints a paste block instead. */}}
{{- /* Asked once per Workstation and kept in the local chezmoi.toml (edit it there); Devcontainers can't prompt. */}}
{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
    obsidianVault = {{ if eq (env "DOTFILES_PROFILE") "devcontainer" }}""{{ else }}{{ promptStringOnce . "obsidianVault" "Obsidian vault path (empty for none)" (ternary "/mnt/c/Users/Gui/Documents/Obsidian Vault" "" $wsl) | quote }}{{ end }}
