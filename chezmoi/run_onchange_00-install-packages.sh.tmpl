{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Installs Ubuntu packages listed in apt-packages.txt, plus packages that
# aren't in Ubuntu's apt repos but are in the Brewfile -- installed via
# Homebrew (Linuxbrew) instead. chezmoi itself is the one exception: it
# can't bootstrap itself, so it's installed via snap before this ever runs
# (see README).
# run_onchange_: chezmoi re-runs when either hash changes.
# apt-packages.txt hash: {{ include "../apt-packages.txt" | sha256sum }}
# Brewfile hash: {{ include "../Brewfile" | sha256sum }}
set -uo pipefail

sudo apt-get update
# Install one package per invocation: a single unavailable package must not
# block every other package in the list.
xargs -a "{{ .chezmoi.sourceDir }}/../apt-packages.txt" -n1 sudo apt-get install -y

set -e
if ! command -v brew &>/dev/null; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Brewfile packages with no Ubuntu apt package.
brew install zellij mise proto
{{ end -}}
