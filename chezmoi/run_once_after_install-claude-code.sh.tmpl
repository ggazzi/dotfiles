#!/usr/bin/env bash
# Installs the Claude Code CLI, replacing the nix-built pkgs/common/claude-code derivation.
# run_once_after_: its download is slow, so it runs after all other scripts.
{{ if not .devcontainer -}}
# Uses `mise exec` rather than a bare `npm` call: run_once_ scripts run
# non-interactively and never source .zshrc's `mise activate` line, so npm
# would otherwise not be on PATH yet.
{{ end -}}
set -euo pipefail

if command -v claude &>/dev/null; then
    exit 0
fi

echo "==> dotfiles: installing Claude Code (slow download)"
{{ if .devcontainer -}}
# Devcontainers have no mise; the native installer needs no node.
curl -fsSL https://claude.ai/install.sh | bash
{{ else -}}
mise install
mise exec -- npm install -g @anthropic-ai/claude-code
{{ end -}}
