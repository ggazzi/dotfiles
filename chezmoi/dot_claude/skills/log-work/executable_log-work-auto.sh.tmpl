#!/usr/bin/env bash
# SessionEnd hook: logs the session via log-work.sh with a Haiku-written sentence.
# Hook mode: reads the hook JSON on stdin, re-launches itself detached and returns at once.
# Usage (internal): log-work-auto.sh --run <session-id>
set -euo pipefail
[ -z "${LOG_WORK_AUTO:-}" ] || exit 0   # the headless claude below ends a session too
here=$(cd "$(dirname "$0")" && pwd)
errlog="$HOME/.claude/log-work-errors.log"

if [ "${1:-}" != "--run" ]; then
    sid=$(jq -r .session_id)
    nohup "$0" --run "$sid" >/dev/null 2>&1 &
    exit 0
fi
sid=$2
trap 'echo "$(date +%FT%T) $sid: failed (line $LINENO)" >>"$errlog"' ERR

# What a new entry would cover (since this session's previous log line): "<prompt count> <seconds>",
# then a plain-text digest.
digest=$(bash "$here/log-work.sh" --digest "$sid" "{{ .obsidianVault }}")

read -r prompts seconds <<<"$(head -1 <<<"$digest")"
# Skip trivia: under 3 prompts or under 2 min (also covers "nothing since the previous log line").
[ "$prompts" -ge 3 ] && [ "$seconds" -ge 120 ] || exit 0

sentence=$(tail -n +2 <<<"$digest" | tail -c 12000 | LOG_WORK_AUTO=1 claude -p --model haiku --no-session-persistence \
    "Above is a digest of a Claude Code session. Write ONE English sentence on what it accomplished: the outcome, not the steps. Start with a past-tense verb (e.g. Fixed, Added, Reviewed); never start with \"The user\" or \"The session\". At most 25 words. Mention PR and issue numbers (e.g. PR #105) when the digest has them. No wikilinks, no quotes. Output only the sentence.")
sentence=$(tr '\n' ' ' <<<"$sentence" | sed 's/^ *//; s/ *$//')
[ -n "$sentence" ] || { echo "$(date +%FT%T) $sid: empty sentence" >>"$errlog"; exit 1; }

# log-work.sh finds the repository from cwd; the hook runs in the session's cwd.
out=$(bash "$here/log-work.sh" "$sid" "{{ .obsidianVault }}" "$sentence")
case $out in "Logged to "*) ;; *) echo "$(date +%FT%T) $sid: $out" >>"$errlog" ;; esac
