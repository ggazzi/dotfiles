{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Installs Ubuntu packages listed in apt-packages.txt.
# chezmoi, mise, and proto are not in Ubuntu's apt repos at all -- they're
# installed separately (chezmoi via snap; mise/proto via run_once_ scripts).
# zellij is also missing and deliberately unmanaged for now -- see README.
# run_onchange_: chezmoi re-runs when this hash changes.
# apt-packages.txt hash: {{ include "../apt-packages.txt" | sha256sum }}
set -uo pipefail

sudo apt-get update
# Install one package per invocation: a single unavailable package (see note
# above) must not block every other package in the list.
xargs -a "{{ .chezmoi.sourceDir }}/../apt-packages.txt" -n1 sudo apt-get install -y
{{ end -}}
