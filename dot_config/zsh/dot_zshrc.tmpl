export WORKSPACE="$HOME/workspace"
export PATH="$HOME/.local/libexec/dev-utils:$HOME/.local/bin:$PATH"

# History search
bindkey "^R" history-incremental-search-backward

# Completion tuning
unsetopt menu_complete  # do not autoselect the first completion entry
setopt auto_menu        # show completion menu on successive tab press
setopt complete_in_word # in-word completion allowed
setopt always_to_end
zmodload -i zsh/complist

alias ".."="cd .."
alias "..."="cd ../.."
alias "...."="cd ../../.."
alias l="ls -CFh"
alias la="ls -CFAh"
alias ll="ls -CFAlh"
alias g="git"
{{ if eq .chezmoi.os "darwin" -}}
alias ls="ls -G"
{{ end -}}

_dev_utils_complete() {
    local root="$HOME/.local/libexec/dev-utils/libexec"
    if (( CURRENT == 2 )); then
        compadd -- "${(@f)$(ls "$root")}"
    elif (( CURRENT == 3 )); then
        compadd -- "${(@f)$(ls "$root/${words[2]}" 2>/dev/null | grep -v README)}"
    fi
}
compdef _dev_utils_complete dev

eval "$(direnv hook zsh)"
eval "$(starship init zsh)"
